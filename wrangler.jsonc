// Cloudflare Workers config: a static-assets-only Worker.
// `npx wrangler deploy` first runs build.command (Next's static export
// into `out/`), then uploads that folder as the site. No server code runs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aethy",
  "compatibility_date": "2026-08-01",
  "build": {
    "command": "npx next build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
